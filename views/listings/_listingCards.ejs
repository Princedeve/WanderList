<% for(list of allListings){ %>

    <a href="/listings/<%= list._id %>" class="listing-link">

        <div class="card col listing-card">

            <img
                src="<%= list.image.url %>"
                class="card-img-top"
                alt="listing_image"
                style="height: 20rem;"
            >

            <div class="card-img-overlay">
                <b>WanderList</b>
            </div>

            <div class="card-body">
                <p class="card-text">
                    <b><%= list.title %></b><br>
                    <%= Number(list.price).toLocaleString("en-IN") %> / night
                    <i class="tax-info">&nbsp; +18% GST</i>
                </p>
            </div>

        </div>

    </a>

<% } %>